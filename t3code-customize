import copy
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import struct
import subprocess
import sys
import tarfile
import time
import urllib.request
import macos

NAME = 't3code-customize'
REPO = Path(__file__).resolve().parent
UPSTREAM = 'https://github.com/pingdotgg/t3code.git'
HOME = Path.home()
SHARE = Path(os.environ.get('XDG_DATA_HOME') or HOME / '.local/share')
DATA = SHARE / NAME
CACHE = Path(os.environ.get('XDG_CACHE_HOME') or HOME / '.cache') / NAME
CONFIG = Path(os.environ.get('XDG_CONFIG_HOME') or HOME / '.config') / NAME
SOURCE = CACHE / 't3code'
STATE = DATA / 'state.json'
CURRENT = DATA / 'current'
DISABLED = DATA / 'disabled'
BIN = HOME / '.local/bin' / NAME
DESKTOP = SHARE / 'applications' / (NAME + '.desktop')
LAUNCHER_NAME = 'T3 Code (Customized)'
SEARCH = ['Applications', 'Downloads', 'AppImages', 'Apps', '.local/bin', 'bin', 'opt']
AGENTS = {
    'claude': ['claude', '-p', '--dangerously-skip-permissions'],
    'codex': ['codex', 'exec', '--dangerously-bypass-approvals-and-sandbox', '--skip-git-repo-check', '-'],
}
AGENT_NAMES = {'claude': 'Claude Code', 'codex': 'Codex'}
GIT_ENV = {'GIT_AUTHOR_NAME': NAME, 'GIT_AUTHOR_EMAIL': NAME + '@localhost',
           'GIT_COMMITTER_NAME': NAME, 'GIT_COMMITTER_EMAIL': NAME + '@localhost',
           'GIT_EDITOR': 'true', 'GIT_SEQUENCE_EDITOR': 'true'}
# Upstream bakes its public cloud config (T3 Connect sign-in and relay) into official
# builds. It sits in every installed app's web bundle; the build reads it from yours.
# Upstream's relay telemetry settings are deliberately left out of customized builds.
PUBLIC_CONFIG = {
    'VITE_CLERK_PUBLISHABLE_KEY': 'T3CODE_CLERK_PUBLISHABLE_KEY',
    'VITE_CLERK_JWT_TEMPLATE': 'T3CODE_CLERK_JWT_TEMPLATE',
    'VITE_CLERK_CLI_OAUTH_CLIENT_ID': 'T3CODE_CLERK_CLI_OAUTH_CLIENT_ID',
    'VITE_T3CODE_RELAY_URL': 'T3CODE_RELAY_URL',
}
# Never prompts (it may run without a terminal) and keeps node_modules consistent between runs.
PNPM_INSTALL = ['--frozen-lockfile', '--ignore-scripts', '--config.confirmModulesPurge=false']
# Strings that only exist in bundles built with the patches.
MARKERS = (('apps/server/dist/client/', b'statsForNerds'), ('apps/server/dist/', b'claude_observed'),
           ('apps/desktop/dist-electron/', b'statsForNerds'))


class Stop(Exception):
    """A clean stop with a message for the user."""


class NeedsFix(Stop):
    """The patches need porting to this upstream commit (conflict or failing check)."""


def say(message=''):
    print(message, flush=True)


def step(message):
    say('==> ' + message)


def run(args, cwd=None, env=None, log=None, check=True, capture=False):
    result = subprocess.run(args, cwd=cwd, env=env, text=capture,
                            stdout=subprocess.PIPE if capture else log,
                            stderr=log if not capture else None)
    if check and result.returncode:
        raise Stop(f'Command failed ({result.returncode}): {" ".join(map(str, args))}' + (f'\nLog: {log.name}' if log else ''))
    return result.stdout if capture else result


def git(*args, check=True, capture=True, log=None):
    env = {**os.environ, **GIT_ENV}
    return run(['git', '-c', 'core.hooksPath=/dev/null', *args], cwd=SOURCE, env=env, check=check, capture=capture, log=log)


def sha256(path):
    digest = hashlib.sha256()
    with Path(path).open('rb') as source:
        for chunk in iter(lambda: source.read(1 << 20), b''):
            digest.update(chunk)
    return digest.hexdigest()


def load(path, default=None):
    return json.loads(path.read_text()) if path.exists() else default


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + '.new')
    temporary.write_text(json.dumps(value, indent=2) + '\n')
    os.replace(temporary, path)


def patches():
    return sorted((REPO / 'patches').glob('*.patch'))


def recipe_hash():
    digest = hashlib.sha256()
    for path in patches() + [REPO / 'patches/base.txt', REPO / 'checks.json', REPO / NAME, REPO / 'macos.py']:
        digest.update(path.name.encode() + path.read_bytes())
    return digest.hexdigest()[:12]


def interactive():
    return sys.stdin.isatty() and sys.stdout.isatty()


def extract_tar(archive, destination):
    with tarfile.open(archive) as bundle:
        if hasattr(tarfile, 'data_filter'):
            bundle.extractall(destination, filter='data')
        else:
            bundle.extractall(destination)


# --- Finding the installed AppImage -------------------------------------------------

def version_key(path):
    return [int(part) if part.isdigit() else part for part in re.split(r'(\d+)', path.name)]


def find_appimage(explicit=None):
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if not path.is_file():
            raise Stop(f'No AppImage at {path}.')
        return path
    configured = load(CONFIG / 'config.json', {}).get('appimage')
    if configured:
        path = Path(configured)
        if path.is_file():
            return path.resolve()
        # T3's updater replaces versioned files; look again in the same folder.
        found = sorted((p for p in path.parent.glob('T3-Code*.AppImage') if p.is_file()), key=version_key)
        if found:
            return found[-1].resolve()
    found = [p for folder in SEARCH for p in (HOME / folder).glob('T3-Code*.AppImage') if p.is_file()]
    if not found:
        raise Stop('Could not find your T3 Code AppImage in ~/' + ', ~/'.join(SEARCH) + '.\n'
                   f'Point to it once with: {NAME} --appimage /path/to/T3-Code-....AppImage')
    return sorted(found, key=version_key)[-1].resolve()


def fingerprint(path):
    stat = path.stat()
    return {'path': str(path), 'size': stat.st_size, 'mtime': stat.st_mtime_ns}


# --- Electron asar archives ---------------------------------------------------------

class Archive:
    def __init__(self, path):
        self.file = Path(path).open('rb')
        _, header_size, _, json_size = struct.unpack('<4I', self.file.read(16))
        self.offset = 8 + header_size
        self.tree = json.loads(self.file.read(json_size))
        self.entries = dict(self.walk(self.tree))

    @staticmethod
    def walk(tree, prefix=''):
        for name, entry in tree.get('files', {}).items():
            if 'files' in entry:
                yield from Archive.walk(entry, prefix + name + '/')
            else:
                yield prefix + name, entry

    def read(self, key):
        entry = self.entries[key]
        self.file.seek(self.offset + int(entry['offset']))
        data = self.file.read(entry['size'])
        if len(data) != entry['size']:
            raise ValueError('Truncated archive entry: ' + key)
        return data

    def scripts(self, prefix):
        for key, entry in self.entries.items():
            if key.startswith(prefix) and key.endswith(('.js', '.mjs', '.cjs')) and not entry.get('unpacked') and 'link' not in entry:
                yield key, self.read(key)

    def close(self):
        self.file.close()


def read_public_config(archive):
    """Upstream's public cloud config from the stock web bundle, by name."""
    found = {}
    for _, data in archive.scripts('apps/server/dist/client/'):
        for name in PUBLIC_CONFIG:
            if name in found:
                continue
            match = re.search(re.escape(name).encode() + rb':\s*([`"\'])([^`"\'\\\n]{1,200})\1', data)
            if match:
                found[name] = match.group(2).decode()
        if len(found) == len(PUBLIC_CONFIG):
            break
    return {PUBLIC_CONFIG[name]: value for name, value in found.items()}


def overlay(stock_path, output, build, config):
    """Write stock_path with the server and desktop bundles replaced by build's, then verify it."""
    stock = Archive(stock_path)
    try:
        tree = copy.deepcopy(stock.tree)

        def node(path):
            current = tree
            for part in path.split('/'):
                current = current['files'][part]
            return current

        node('apps/server/dist')['files']['client'] = {'files': {}}
        overlays = {}
        for prefix in ('apps/server/dist', 'apps/desktop/dist-electron'):
            source = build / prefix
            for path in sorted(source.rglob('*')):
                if path.is_symlink():
                    raise Stop('Unexpected symlink in the build output: ' + str(path))
                if not path.is_file():
                    continue
                relative = path.relative_to(source).as_posix()
                current = node(prefix)
                parts = relative.split('/')
                for part in parts[:-1]:
                    current = current['files'].setdefault(part, {'files': {}})
                data = path.read_bytes()
                block = 4194304
                current['files'][parts[-1]] = {'size': len(data), 'integrity': {
                    'algorithm': 'SHA256', 'hash': hashlib.sha256(data).hexdigest(), 'blockSize': block,
                    'blocks': [hashlib.sha256(data[i:i + block]).hexdigest() for i in range(0, len(data), block)]}}
                overlays[prefix + '/' + relative] = path
        for required in ('apps/server/dist/bin.mjs', 'apps/server/dist/client/index.html',
                         'apps/desktop/dist-electron/main.cjs'):
            if required not in overlays:
                raise Stop('The build did not produce ' + required)
        records, cursor = [], 0
        for key, entry in Archive.walk(tree):
            if 'link' in entry or entry.get('unpacked'):
                continue
            entry['offset'] = str(cursor)
            cursor += entry['size']
            records.append(key)
        encoded = json.dumps(tree, separators=(',', ':'), ensure_ascii=False).encode()
        padded = encoded + b'\0' * ((-len(encoded)) % 4)
        header = struct.pack('<II', 4 + len(padded), len(encoded)) + padded
        with output.open('wb') as target:
            target.write(struct.pack('<II', 4, len(header)))
            target.write(header)
            for key in records:
                target.write(overlays[key].read_bytes() if key in overlays else stock.read(key))
        patched = Archive(output)
        try:
            for key, path in overlays.items():
                if patched.read(key) != path.read_bytes():
                    raise Stop('Archive verification failed for ' + key)
            for key, entry in stock.entries.items():
                if key in overlays or key.startswith('apps/server/dist/client/'):
                    continue
                same = (entry == patched.entries.get(key) if entry.get('unpacked') or 'link' in entry
                        else key in patched.entries and stock.read(key) == patched.read(key))
                if not same:
                    raise Stop('Archive verification failed for stock entry ' + key)
            for prefix, marker in MARKERS:
                if not any(marker in data for _, data in patched.scripts(prefix)):
                    raise Stop(f'The rebuilt bundle under {prefix} is missing the stats bar.')
            # Connect needs the same public config as stock in every bundle that carries it.
            for prefix in ('apps/server/dist/client/', 'apps/server/dist/', 'apps/desktop/dist-electron/'):
                def contents(archive):
                    return b''.join(data for key, data in archive.scripts(prefix)
                                    if prefix.endswith('client/') or '/client/' not in key)
                stock_data, patched_data = contents(stock), contents(patched)
                for key, value in config.items():
                    if value.encode() in stock_data and value.encode() not in patched_data:
                        raise Stop(f'The rebuilt bundle under {prefix} is missing T3 Connect config ({key}).')
        finally:
            patched.close()
    finally:
        stock.close()


# --- Tools --------------------------------------------------------------------------

def node_major(node):
    try:
        out = subprocess.run([node, '-p', 'process.versions.node'], capture_output=True, text=True, check=True).stdout
        return int(out.split('.')[0])
    except (OSError, subprocess.CalledProcessError, ValueError):
        return 0


def node_target():
    arch = {'x86_64': 'x64', 'aarch64': 'arm64', 'arm64': 'arm64'}.get(os.uname().machine)
    platform = {'darwin': 'darwin', 'linux': 'linux'}.get(sys.platform)
    if not arch or not platform:
        raise Stop('Node 24 or newer is required on a supported macOS or Linux architecture.')
    return platform, arch, '.tar.gz' if platform == 'darwin' else '.tar.xz'


def ensure_node(log):
    """Use the system Node if it is new enough, else a private copy from nodejs.org."""
    system = shutil.which('node')
    if system and node_major(system) >= 24:
        return None
    platform, arch, suffix = node_target()
    private = sorted((CACHE / 'node').glob(f'node-v24.*-{platform}-{arch}'), key=version_key)
    if private and node_major(str(private[-1] / 'bin/node')) >= 24:
        return private[-1] / 'bin'
    step('Downloading Node 24 (one time, private to this tool)...')
    with urllib.request.urlopen('https://nodejs.org/dist/index.json', timeout=30) as response:
        releases = json.load(response)
    index_target = f'osx-{arch}-tar' if platform == 'darwin' else f'{platform}-{arch}'
    version = next((r['version'] for r in releases
                    if r['version'].startswith('v24.') and index_target in r['files']), None)
    if version is None:
        raise Stop(f'No Node 24 download was published for {platform}/{arch}. Install Node 24 or newer and retry.')
    name = f'node-{version}-{platform}-{arch}'
    base = f'https://nodejs.org/dist/{version}/'
    with urllib.request.urlopen(base + 'SHASUMS256.txt', timeout=30) as response:
        sums = dict(reversed(line.split()) for line in response.read().decode().splitlines() if line.strip())
    folder = CACHE / 'node'
    folder.mkdir(parents=True, exist_ok=True)
    archive = folder / (name + suffix)
    urllib.request.urlretrieve(base + archive.name, archive)
    if sha256(archive) != sums.get(archive.name):
        archive.unlink()
        raise Stop('The Node download did not match its published checksum.')
    extract_tar(archive, folder)
    archive.unlink()
    return folder / name / 'bin'


def build_env(node_bin):
    env = os.environ.copy()
    paths = [str(SOURCE / 'node_modules/.bin')] + ([str(node_bin)] if node_bin else [])
    env['PATH'] = os.pathsep.join(paths + [env.get('PATH', '')])
    for key in ('T3CODE_DESKTOP_DEV', 'VITE_HTTP_URL', 'VITE_WS_URL', 'NODE_ENV'):
        env.pop(key, None)
    # Nothing from the user's shell may stand in for upstream config.
    for key in list(env):
        if key.startswith(('T3CODE_', 'VITE_', 'EXPO_PUBLIC_')):
            env.pop(key)
    return env


def pnpm(env):
    if shutil.which('pnpm', path=env['PATH']):
        return ['pnpm']
    manager = json.loads((SOURCE / 'package.json').read_text()).get('packageManager', 'pnpm')
    return ['npx', '--yes', manager.split('+')[0]]


# --- Source checkout ----------------------------------------------------------------

def rebase_in_progress():
    gitdir = Path(git('rev-parse', '--absolute-git-dir').strip())
    return (gitdir / 'rebase-merge').exists() or (gitdir / 'rebase-apply').exists()


def has_commit(ref):
    return git('cat-file', '-e', ref + '^{commit}', check=False, capture=False).returncode == 0


def ensure_commit(commit, version, log):
    if not (SOURCE / '.git').exists():
        step('Downloading T3 Code source history (one time)...')
        shutil.rmtree(SOURCE, ignore_errors=True)
        SOURCE.parent.mkdir(parents=True, exist_ok=True)
        run(['git', 'clone', '--filter=blob:none', '--no-checkout', UPSTREAM, str(SOURCE)], log=log)
    if not has_commit(commit):
        git('fetch', '--quiet', 'origin', capture=False, log=log, check=False)
        if version and not has_commit(commit):
            git('fetch', '--quiet', 'origin', 'tag', 'v' + version, capture=False, log=log, check=False)
    if not has_commit(commit):
        raise Stop(f'Upstream commit {commit} is not on GitHub yet. Try again in a little while.')
    return git('rev-parse', commit + '^{commit}').strip()


def prepare(target, log, resume=False):
    """Leave SOURCE with the patches as commits on top of target."""
    base = (REPO / 'patches/base.txt').read_text().strip()
    if not resume:
        if rebase_in_progress():
            # Start over from the repo's patches; a fresh build never continues an old port.
            git('am', '--abort', check=False, capture=False, log=log)
            git('rebase', '--abort', check=False, capture=False, log=log)
        git('checkout', '--quiet', '--force', '--detach', base, capture=False, log=log)
        # Keep node_modules so dependency installs stay fast between builds.
        git('clean', '-ffdxq', '-e', 'node_modules', capture=False, log=log)
        if git('am', '--quiet', '--committer-date-is-author-date', *map(str, patches()), check=False, capture=False, log=log).returncode:
            git('am', '--abort', check=False, capture=False, log=log)
            raise Stop(f'The patches do not apply to their own base {base[:12]}. Check git status in {REPO}.')
        if base != target:
            git('rebase', '--quiet', '--onto', target, base, check=False, capture=False, log=log)
    if rebase_in_progress():
        conflicted = git('diff', '--name-only', '--diff-filter=U').split()
        raise NeedsFix('The patches conflict with this nightly in:\n' + '\n'.join('  ' + f for f in conflicted))
    if git('status', '--porcelain', '--untracked-files=no').strip():
        raise NeedsFix('The source checkout has uncommitted changes in ' + str(SOURCE) + '.')
    if git('merge-base', '--is-ancestor', target, 'HEAD', check=False, capture=False).returncode:
        raise NeedsFix('The patch commits are not on top of the nightly commit ' + target[:12] + '.')


def install_dependencies(env, log):
    first = not (SOURCE / 'node_modules').exists()
    step('Installing build dependencies' + (' (one time, a few minutes)...' if first else '...'))
    # Only JavaScript is rebuilt; native parts come from your own app, so no install scripts run.
    run([*pnpm(env), 'install', *PNPM_INSTALL], cwd=SOURCE, env=env, log=log)


def checks(env, log):
    spec = json.loads((REPO / 'checks.json').read_text())
    missing = [t for t in spec['tests'] if not (SOURCE / t).exists()]
    if missing:
        raise NeedsFix('Test files listed in checks.json no longer exist (moved upstream?):\n' + '\n'.join('  ' + t for t in missing))
    step('Testing the patches...')
    steps = [(['vp', 'test', 'run', *spec['tests']], 'The patch tests failed.')]
    steps += [(['tsc', '--noEmit', '-p', p + '/tsconfig.json'], f'Typecheck failed in {p}.') for p in spec['typecheck']]
    for args, message in steps:
        if run(args, cwd=SOURCE, env=env, log=log, check=False).returncode:
            raise NeedsFix(message + ' Command: ' + ' '.join(args))


def build_bundles(env, version, stock_root, config, log):
    step('Building T3 Code...')
    env = dict(env, APP_VERSION=version, TMPDIR=str(CACHE / 'tmp'), **config)
    Path(env['TMPDIR']).mkdir(parents=True, exist_ok=True)
    packages = [SOURCE / 'apps' / app / 'package.json' for app in ('web', 'server', 'desktop')]
    # The desktop build regenerates this tracked file; put the committed copy back afterwards.
    generated = [SOURCE / 'apps/desktop/src/preview/AnnotationStyles.generated.ts']
    originals = {path: path.read_bytes() for path in packages + generated if path.exists()}
    try:
        for path in packages:
            package = json.loads(originals[path])
            package['version'] = version
            path.write_text(json.dumps(package, indent=2) + '\n')
        run(['vp', 'build'], cwd=SOURCE / 'apps/web', env=env, log=log)
        run(['node', 'scripts/cli.ts', 'build'], cwd=SOURCE / 'apps/server', env=env, log=log)
        brand = 'nightly' if 'nightly' in version else 'production'
        run(['node', 'scripts/apply-web-brand-assets.ts', brand, 'apps/server/dist/client'], cwd=SOURCE, env=env, log=log)
        # Reuse the native helper from your own app instead of compiling it.
        arch = {'x86_64': 'x64', 'aarch64': 'arm64', 'arm64': 'arm64'}.get(os.uname().machine, 'x64')
        helper = SOURCE / f'native/browser-secret/build/{arch}/t3-browser-secret'
        resources = stock_root / ('Contents/Resources' if sys.platform == 'darwin' else 'resources')
        stock_helper = resources / 'browser-secret/t3-browser-secret'
        if stock_helper.exists():
            helper.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(stock_helper, helper)
            os.utime(helper, None)
        run(['node', 'scripts/build-browser-secret.mjs'], cwd=SOURCE / 'apps/desktop', env=env, log=log)
        run(['node', 'scripts/build-preview-annotation-css.mjs'], cwd=SOURCE / 'apps/desktop', env=env, log=log)
        run(['vp', 'pack'], cwd=SOURCE / 'apps/desktop', env=env, log=log)
    finally:
        for path, original in originals.items():
            path.write_bytes(original)


# --- Porting help -------------------------------------------------------------------

def available_agents():
    return [name for name in AGENTS if shutil.which(name)]


def choose_agent(requested):
    """The agent to port the patches with, asking first when run by a person."""
    if requested:
        if not shutil.which(requested):
            raise Stop(f'{requested} is not installed.')
        return requested
    agents = available_agents()
    if not agents or not interactive():
        return None
    name = agents[0]
    say()
    say(f'This nightly changed code the patches touch. {AGENT_NAMES[name]} can port them for you')
    say(f'(usually 10 to 30 minutes). It runs with full permissions, only inside {SOURCE}.')
    answer = input(f'Let {AGENT_NAMES[name]} fix it now? [Y/n] ').strip().lower()
    return name if answer in ('', 'y', 'yes') else None


def agent_fix(agent, problem, target, version, log):
    prompt = (f'Follow {REPO}/AGENTS.md to port the T3 Code customization patches.\n\n'
              f'Source checkout: {SOURCE}\nNightly: {version} at commit {target}\n'
              f'Patch repo: {REPO}\n\nThe build stopped with:\n\n{problem}\n\n'
              f'When the checks pass, stop. Do not run the build yourself; {NAME} continues it.\n')
    step(f'{AGENT_NAMES[agent]} is porting the patches. Transcript: {log.name}')
    log.write('\n--- agent prompt ---\n' + prompt + '\n')
    log.flush()
    result = subprocess.run(AGENTS[agent], cwd=SOURCE, input=prompt, text=True, stdout=log, stderr=log)
    if result.returncode:
        say(f'{AGENT_NAMES[agent]} exited with {result.returncode}; checking what it left.')


def older_than_patches(target):
    base = (REPO / 'patches/base.txt').read_text().strip()
    return target != base and git('merge-base', '--is-ancestor', target, base, check=False, capture=False).returncode == 0


def stuck_message(problem, target):
    if older_than_patches(target):
        return (f'{problem}\n\nYour T3 Code is older than these patches. Update T3 Code, then run {NAME} again.\n'
                'Your current T3 Code is untouched.')
    return (f'{problem}\n\nThis nightly changed code the patches touch. Any of these works:\n'
            f'  - wait for the repo to catch up (usually within a day), then run {NAME} again\n'
            f'  - let an agent port them now: {NAME} --fix claude  (or --fix codex)\n'
            f'  - or ask your coding agent to follow {REPO}/AGENTS.md\n'
            'Your current T3 Code is untouched and still opens normally.')


# --- Commands -----------------------------------------------------------------------

def pull_latest():
    """Fast-forward this repo to the latest patches, keeping any local port in a backup."""
    if not (REPO / '.git').exists():
        return
    status = subprocess.run(['git', 'status', '--porcelain', '--', 'patches', 'checks.json'],
                            cwd=REPO, capture_output=True, text=True).stdout
    before = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=REPO, capture_output=True, text=True).stdout
    if subprocess.run(['git', 'fetch', '--quiet'], cwd=REPO, stderr=subprocess.DEVNULL).returncode:
        say('Could not check for newer patches (offline?). Using the ones you have.')
        return
    behind = subprocess.run(['git', 'rev-list', '--count', 'HEAD..@{u}'], cwd=REPO, capture_output=True, text=True).stdout.strip()
    if behind in ('', '0'):
        return
    if status.strip():
        backup = DATA / ('patches.bak-' + time.strftime('%Y%m%d-%H%M%S'))
        shutil.copytree(REPO / 'patches', backup)
        subprocess.run(['git', 'checkout', '--quiet', '--', 'patches', 'checks.json'], cwd=REPO, check=True)
        say(f'Newer patches are available; your local port was saved to {backup}.')
    if subprocess.run(['git', 'merge', '--ff-only', '--quiet', '@{u}'], cwd=REPO).returncode:
        raise Stop(f'Could not update {REPO} to the latest patches. Run git status there.')
    after = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=REPO, capture_output=True, text=True).stdout
    if after != before:
        step('Got the latest patches.')
        # The script itself may have changed; continue with the new one.
        os.execv(sys.executable, [sys.executable, str(REPO / NAME), *sys.argv[1:], '--no-pull'])


def install_launcher(appimage_dir):
    BIN.parent.mkdir(parents=True, exist_ok=True)
    if BIN.is_symlink() or not BIN.exists():
        BIN.unlink(missing_ok=True)
        BIN.symlink_to(REPO / NAME)
    DESKTOP.parent.mkdir(parents=True, exist_ok=True)
    DESKTOP.write_text('\n'.join([
        '[Desktop Entry]', 'Type=Application', f'Name={LAUNCHER_NAME}',
        'Comment=T3 Code with a stats bar under the composer',
        f'Exec="{BIN}" launch %U', f'Icon={DATA / "icon.png"}', 'Terminal=false',
        'StartupWMClass=com.t3tools.T3Code', 'Categories=Development;', '']))
    if shutil.which('update-desktop-database'):
        subprocess.run(['update-desktop-database', str(DESKTOP.parent)], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if str(BIN.parent) not in os.environ.get('PATH', '').split(os.pathsep):
        say(f'Note: {BIN.parent} is not on your PATH. Add it to run {NAME} from anywhere.')


def build_for_version(args, version, commit, stock_root, config, log):
    """Apply, check and rebuild patches for either desktop packaging format."""
    if not re.fullmatch(r'[0-9a-f]{7,40}', commit):
        raise Stop('This app does not record its source commit, so it cannot be rebuilt exactly.')
    env = build_env(ensure_node(log))
    target = ensure_commit(commit, version, log)
    step('Applying the patches...')
    attempts = 2
    resume = ported = args.resume
    agent = None
    while True:
        try:
            prepare(target, log, resume=resume)
            install_dependencies(env, log)
            validated_head = git('rev-parse', 'HEAD').strip()
            if not args.skip_checks:
                checks(env, log)
            if (git('rev-parse', 'HEAD').strip() != validated_head
                    or git('status', '--porcelain', '--untracked-files=no').strip()):
                raise Stop('The source checkout changed during the checks; retry from clean source.')
            break
        except NeedsFix as problem:
            if older_than_patches(target):
                raise Stop(stuck_message(problem, target))
            say(str(problem))
            agent = agent or choose_agent(args.fix)
            if not agent or attempts == 0:
                raise NeedsFix(stuck_message(problem, target))
            attempts -= 1
            agent_fix(agent, str(problem), target, version, log)
            resume = ported = True
    head = git('rev-parse', 'HEAD').strip()
    build_bundles(env, version, stock_root, config, log)
    if (git('rev-parse', 'HEAD').strip() != head
            or git('status', '--porcelain', '--untracked-files=no').strip()):
        raise Stop('The source checkout changed during the build.')
    return target, ported


def cmd_build(args):
    started = time.time()
    if not shutil.which('git'):
        raise Stop('git is required. Install it and run again.')
    if not args.no_pull and not args.resume:
        pull_latest()
    appimage = find_appimage(args.appimage)
    if args.appimage:
        save(CONFIG / 'config.json', {**load(CONFIG / 'config.json', {}), 'appimage': str(appimage)})
    say('T3 Code: ' + str(appimage))
    state = load(STATE, {})
    recipe = recipe_hash()
    if (not args.force and not args.resume and state.get('stock') == fingerprint(appimage)
            and state.get('recipe') == recipe and (CURRENT / 'AppRun').exists()):
        install_launcher(appimage.parent)
        say(f'\nAlready up to date. Open "{LAUNCHER_NAME}" from your app launcher.')
        return
    DATA.mkdir(parents=True, exist_ok=True)
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    job = CACHE / 'work' / time.strftime('%Y%m%d-%H%M%S')
    job.mkdir(parents=True)
    with (logs / (job.name + '.log')).open('w') as log:
        say('Log: ' + log.name)
        step('Reading your T3 Code...')
        run([str(appimage), '--appimage-extract'], cwd=job, log=log)
        stock_root = job / 'squashfs-root'
        archive = Archive(stock_root / 'resources/app.asar')
        try:
            metadata = json.loads(archive.read('package.json'))
            config = read_public_config(archive)
        finally:
            archive.close()
        version, commit = metadata['version'], metadata.get('t3codeCommitHash', '')
        if 'nightly' not in version:
            raise Stop(f'This is T3 Code {version}. The patches target T3 Code Nightly; install Nightly and run again.')
        if not re.fullmatch(r'[0-9a-f]{7,40}', commit):
            raise Stop('This AppImage does not record its source commit, so it cannot be rebuilt exactly.')
        say(f'    Nightly {version}, upstream commit {commit[:12]}')
        if len(config) != len(PUBLIC_CONFIG):
            say('    Note: could not read T3 Connect config from your app; sign-in may not work in this build.')
        target, ported = build_for_version(args, version, commit, stock_root, config, log)
        step('Assembling and verifying your customized app...')
        output = job / 'app.asar'
        overlay(stock_root / 'resources/app.asar', output, SOURCE, config)
        shutil.move(str(output), stock_root / 'resources/app.asar')
        if ported:
            export_patches(target)
        destination = DATA / 'builds' / f'{version}-{recipe_hash()}-{job.name}'
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(stock_root), destination)
        link = DATA / 'current.new'
        if link.is_symlink():
            link.unlink()
        link.symlink_to(destination.relative_to(DATA))
        os.replace(link, CURRENT)
        save(STATE, {'stock': fingerprint(appimage), 'version': version, 'commit': target, 'recipe': recipe_hash(),
                     'build': str(destination), 'connect': len(config) == len(PUBLIC_CONFIG),
                     'builtAt': time.strftime('%Y-%m-%dT%H:%M:%S')})
        icon = destination / 't3code.png'
        if icon.exists():
            shutil.copy2(icon, DATA / 'icon.png')
        prune()
    shutil.rmtree(job, ignore_errors=True)
    install_launcher(appimage.parent)
    minutes = max(1, round((time.time() - started) / 60))
    say(f'\nDone in {minutes} min: T3 Code {version} with the stats bar.')
    if ported:
        say(f'The ported patches were saved to {REPO / "patches"}.')
    if DISABLED.exists():
        say(f'Customization is switched off. Run {NAME} on to use it.')
    else:
        say(f'Quit T3 Code fully, then open "{LAUNCHER_NAME}" from your app launcher.')
        say('First time? Turn on Settings > General > Stats for nerds.')


def export_patches(target):
    """Keep a port that an agent or you finished, so the next build starts from it."""
    out = REPO / 'patches'
    for path in patches():
        path.unlink()
    git('format-patch', '--quiet', '--no-signature', '--zero-commit', '-o', str(out), target + '..HEAD', capture=False)
    (out / 'base.txt').write_text(target + '\n')


def prune(keep=3):
    """Drop old builds, keeping the newest few so a running instance never loses its files."""
    current = CURRENT.resolve()
    builds = sorted((DATA / 'builds').iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
    for old in builds[keep:]:
        if old.resolve() != current:
            shutil.rmtree(old, ignore_errors=True)


def cmd_verify(args):
    """Apply the patches to their base and run the checks. No AppImage needed (used by CI)."""
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    base = (REPO / 'patches/base.txt').read_text().strip()
    with (logs / ('verify-' + time.strftime('%Y%m%d-%H%M%S') + '.log')).open('w') as log:
        say('Log: ' + log.name)
        env = build_env(ensure_node(log))
        target = ensure_commit(base, None, log)
        prepare(target, log)
        install_dependencies(env, log)
        checks(env, log)
    say('Patches apply and pass their checks on ' + base[:12] + '.')


def launch_target():
    """The customized build if it was made from the AppImage installed right now, else stock."""
    appimage = find_appimage()
    state = load(STATE, {})
    built = CURRENT / 'AppRun'
    if DISABLED.exists() or not built.exists():
        return appimage, None
    if state.get('stock') != fingerprint(appimage):
        return appimage, f'T3 Code was updated. Run {NAME} in a terminal to bring the stats bar back.'
    return built.resolve(), None


def cmd_launch(args):
    appimage = find_appimage()
    target, notice = launch_target()
    if notice:
        say(notice)
        if shutil.which('notify-send'):
            subprocess.run(['notify-send', '-a', 'T3 Code', 'Opening stock T3 Code', notice], check=False)
    if target != appimage:
        # Run the extracted copy as if it were the AppImage, so T3's own updater still updates the real file.
        os.environ['APPIMAGE'] = str(appimage)
        os.environ['APPDIR'] = str(target.parent)
    os.execv(str(target), [str(target), *args.rest])


def cmd_status(args):
    appimage = find_appimage()
    state = load(STATE, {})
    target, notice = launch_target()
    say('Installed T3 Code:  ' + str(appimage))
    say('Customized build:   ' + (f"{state['version']} (built {state['builtAt']})" if state else 'none yet'))
    say('Switched:           ' + ('off' if DISABLED.exists() else 'on'))
    say('Next launch opens:  ' + ('customized build' if target != appimage else 'stock T3 Code'))
    if notice:
        say(notice)


def cmd_on(args):
    DISABLED.unlink(missing_ok=True)
    say('Customization on. Quit T3 Code fully and reopen it.')


def cmd_off(args):
    DATA.mkdir(parents=True, exist_ok=True)
    DISABLED.touch()
    say('Stock T3 Code on the next launch. Quit it fully and reopen it.')


def cmd_uninstall(args):
    if BIN.is_symlink() and BIN.resolve() == (REPO / NAME).resolve():
        BIN.unlink()
    DESKTOP.unlink(missing_ok=True)
    for folder in (DATA, CACHE, CONFIG):
        shutil.rmtree(folder, ignore_errors=True)
    tail = '' if DATA in REPO.parents else f' You can delete {REPO} too.'
    say('Removed t3code-customize, its launcher, builds and caches. Your T3 Code and its data are untouched.' + tail)


def main():
    parser = argparse.ArgumentParser(prog=NAME, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog='With no command, it updates the patches and builds for your installed T3 Code.')
    sub = parser.add_subparsers(dest='command')

    def build_options(p):
        p.add_argument('--appimage', help='path to your T3 Code AppImage (remembered)')
        p.add_argument('--app', help='macOS T3 Code Nightly .app path (remembered)')
        p.add_argument('--build-only', action='store_true', help='macOS: prepare a verified build without installing it')
        p.add_argument('--fix', choices=sorted(AGENTS), help='if a nightly breaks the patches, let this agent port them without asking')
        p.add_argument('--resume', action='store_true', help='continue from the source checkout as you or your agent left it')
        p.add_argument('--skip-checks', action='store_true', help='skip the patch tests and typechecks')
        p.add_argument('--force', action='store_true', help='rebuild even if nothing changed')
        p.add_argument('--no-pull', action='store_true', help='do not fetch newer patches first')

    build_options(sub.add_parser('build', help='update the patches and build (the default)'))
    build_options(sub.add_parser('install', help='build and install the customization'))
    build_options(sub.add_parser('reinstall', help='reapply to the installed Nightly after an update'))
    launch = sub.add_parser('launch', help='open the customized build if it matches your T3 Code, else stock')
    launch.add_argument('rest', nargs=argparse.REMAINDER)
    for command, help_text in [('status', 'show customization status'), ('on', 'use the customized build'),
                               ('off', 'restore stock T3 Code'), ('restore', 'restore stock T3 Code'),
                               ('uninstall', 'restore stock and remove customization tooling')]:
        p = sub.add_parser(command, help=help_text)
        p.add_argument('--app', help='macOS T3 Code Nightly .app path')
    sub.add_parser('verify', help='apply the patches to their base and run the checks (for CI)')
    argv = sys.argv[1:]
    if not argv or argv[0].startswith('-') and argv[0] not in ('-h', '--help'):
        argv = ['build', *argv]
    args = parser.parse_args(argv)
    is_mac = sys.platform == 'darwin' and args.command != 'verify'
    alias = {'install': 'build', 'reinstall': 'build', 'restore': 'off'}.get(args.command, args.command)
    handler = (lambda a: macos.dispatch(a, sys.modules[__name__])) if is_mac else globals()['cmd_' + alias]
    if not is_mac and args.command in ('launch', 'status', 'on', 'off', 'restore'):
        return handler(args)
    CACHE.mkdir(parents=True, exist_ok=True)
    with (CACHE / 'lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Stop(f'Another {NAME} is already running.')
        handler(args)


if __name__ == '__main__':
    try:
        main()
    except (Stop, macos.Error, OSError, subprocess.CalledProcessError) as stop:
        print(f'\n{stop}', file=sys.stderr)
        sys.exit(3 if isinstance(stop, NeedsFix) else 1)
    except KeyboardInterrupt:
        print('\nStopped. Run status before retrying; stock backups and recovery files are retained.', file=sys.stderr)
        sys.exit(130)
