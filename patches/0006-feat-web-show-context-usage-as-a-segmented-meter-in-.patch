+describe("contextMeterFilledSegments", () => {
+  it("lights no block below a reading and one for any usage at all", () => {
+    for (const percentage of [0, -5, Number.NaN, Number.NEGATIVE_INFINITY]) {
+      expect(contextMeterFilledSegments(percentage, 16)).toBe(0);
+    }
+    expect(contextMeterFilledSegments(0.2, 16)).toBe(1);
+    expect(contextMeterFilledSegments(6, 16)).toBe(1);
+  });
+  it("rounds up to the block a reading reaches and stops at the last one", () => {
+    expect(contextMeterFilledSegments(50, 16)).toBe(8);
+    expect(contextMeterFilledSegments(51, 16)).toBe(9);
+    expect(contextMeterFilledSegments(100, 16)).toBe(16);
+    expect(contextMeterFilledSegments(140, 16)).toBe(16);
+    expect(contextMeterFilledSegments(Number.POSITIVE_INFINITY, 16)).toBe(16);
+  });
+});
diff --git a/apps/web/src/components/chat/ComposerStats.logic.ts b/apps/web/src/components/chat/ComposerStats.logic.ts
index 7e6856ea4..b5231976f 100644
--- a/apps/web/src/components/chat/ComposerStats.logic.ts
+++ b/apps/web/src/components/chat/ComposerStats.logic.ts
@@ -306,3 +306,15 @@ export function deriveContextCompaction(
               : "Not reported";
   return { threshold, source, remainingTokens, thresholdPercentage, pressurePercentage, status };
 }
+
+/**
+ * Blocks lit on the segmented context meter.
+ *
+ * Any usage at all lights the first block, so a nearly empty window still reads
+ * as started, and a reading rounds up to the block it reaches.
+ */
+export function contextMeterFilledSegments(percentage: number, segments: number): number {
+  if (Number.isNaN(percentage) || percentage <= 0) return 0;
+  const clamped = Math.min(100, percentage);
+  return Math.min(segments, Math.max(1, Math.ceil((clamped / 100) * segments)));
+}
