+const CONTEXT_METER_SEGMENTS = 16;
+
+/** The stats line's at-a-glance read on how full the window is, blocks lighting as it fills. */
+function ContextMeter({ percentage, pressure }: { percentage: number; pressure: number }) {
+  const tone = toneOf(pressure);
+  const filled = contextMeterFilledSegments(percentage, CONTEXT_METER_SEGMENTS);
+  return (
+    <span aria-hidden="true" className="inline-flex items-center gap-px">
+      {Array.from({ length: CONTEXT_METER_SEGMENTS }, (_, index) => (
+        <span
+          key={index}
+          className={`h-2 w-[3px] rounded-[1px] transition-colors duration-300 motion-reduce:transition-none ${
+            index < filled ? TONE_FILL[tone] : "bg-foreground/15"
+          }`}
+        />
+      ))}
+    </span>
+  );
+}
