@@ -0,0 +1,31 @@
+import { describe, expect, it } from "vite-plus/test";
+import { parsePiTokenSpeed } from "./tokenSpeed.ts";
+
+describe("pi-token-speed footer", () => {
+  it("reads the real ANSI footer including optional suffixes", () => {
+    expect(
+      parsePiTokenSpeed(
+        "⚡ \x1b[2mTPS:\x1b[0m \x1b[38;2;0;255;136m32.5 tok/s\x1b[0m (100 tok in 3.1s · TTFT: 50 ms)\u200b",
+      ),
+    ).toEqual({ basis: "pi_token_speed_extension", tokensPerSecond: 32.5 });
+    expect(parsePiTokenSpeed("TPS: 0.0 tok/s\u200b")?.tokensPerSecond).toBe(0);
+  });
+  it("distinguishes clear/placeholder from malformed updates", () => {
+    expect(parsePiTokenSpeed(undefined)).toBeNull();
+    expect(parsePiTokenSpeed("⚡ TPS: --")).toBeNull();
+    for (const text of [
+      "",
+      "TPS: -3 tok/s",
+      "TPS: NaN tok/s",
+      "TPS: Infinity tok/s",
+      "TPS: 1e20 tok/s",
+      "hello 35 tok/s",
+      "TPS: 35 tok/sec",
+      "TPS: 35 tok/sjunk",
+      35,
+      null,
+    ]) {
+      expect(parsePiTokenSpeed(text)).toBeUndefined();
+    }
+  });
+});
diff --git a/packages/provider-pi/src/server/tokenSpeed.ts b/packages/provider-pi/src/server/tokenSpeed.ts
new file mode 100644
index 000000000..a2ccd18d3
--- /dev/null
+++ b/packages/provider-pi/src/server/tokenSpeed.ts
@@ -0,0 +1,17 @@
+import * as NodeUtil from "node:util";
+import type { OrchestrationV2ProviderTurn } from "@t3tools/contracts";
+
+/** Parse only pi-token-speed's footer, never infer counters from a formatted rate. */
+export function parsePiTokenSpeed(
+  text: unknown,
+): OrchestrationV2ProviderTurn["responseTokenSpeed"] {
+  if (text === undefined) return null;
+  if (typeof text !== "string" || text.length > 4096) return undefined;
+  const plain = NodeUtil.stripVTControlCharacters(text).replaceAll("\u200b", "").trim();
+  if (/(?:^|\s)TPS:\s*--$/.test(plain)) return null;
+  const match = /(?:^|\s)TPS:\s*(\d+(?:\.\d+)?)\s+tok\/s(?:\s|$)/.exec(plain);
+  if (!match) return undefined;
+  const tokensPerSecond = Number(match[1]);
+  if (!Number.isFinite(tokensPerSecond)) return undefined;
+  return { basis: "pi_token_speed_extension", tokensPerSecond };
+}
