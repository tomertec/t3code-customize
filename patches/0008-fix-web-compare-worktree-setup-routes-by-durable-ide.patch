 .../chat/useWorktreeSetup.browser.test.tsx    | 44 +++++++++++++++++++
 .../src/components/chat/useWorktreeSetup.ts   |  6 ++-
 2 files changed, 48 insertions(+), 2 deletions(-)
 create mode 100644 apps/web/src/components/chat/useWorktreeSetup.browser.test.tsx

diff --git a/apps/web/src/components/chat/useWorktreeSetup.browser.test.tsx b/apps/web/src/components/chat/useWorktreeSetup.browser.test.tsx
new file mode 100644
index 0000000000..08f81511db
--- /dev/null
+++ b/apps/web/src/components/chat/useWorktreeSetup.browser.test.tsx
@@ -0,0 +1,44 @@
+import { EnvironmentId, ThreadId } from "@t3tools/contracts";
+import { act, useState } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, expect, it, vi } from "vite-plus/test";
+import { useWorktreeSetup } from "./useWorktreeSetup";
+
+vi.mock("../../state/query", () => ({ useEnvironmentQuery: () => ({ data: undefined }) }));
+vi.mock("../../state/use-atom-command", () => ({ useAtomCommand: () => vi.fn() }));
+vi.mock("../../state/threads", () => ({
+  threadEnvironment: { retryWorkspacePreparation: {} },
+  environmentThreadShells: vi.fn(),
+  environmentThreadDetails: vi.fn(),
+}));
+vi.mock("../../state/vcs", () => ({ vcsEnvironment: { cancelWorktreeSetup: {}, worktreeSetup: vi.fn() } }));
+vi.mock("../../terminalUiStateStore", () => ({ useTerminalUiStateStore: () => vi.fn() }));
+vi.mock("../../lib/terminalFocus", () => ({ focusTerminal: vi.fn() }));
+
+let renderer: Root | null = null;
+let container: HTMLDivElement;
+afterEach(async () => {
+  await act(() => renderer?.unmount());
+  renderer = null;
+  vi.unstubAllGlobals();
+});
+
+it("settles when ChatView recreates the same route reference during render retries", async () => {
+  vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  let renders = 0;
+  function Probe() {
+    renders++;
+    const [ready, setReady] = useState(false);
+    if (!ready) setReady(true);
+    const setup = useWorktreeSetup({
+      routeThreadRef: { environmentId: EnvironmentId.make("local"), threadId: ThreadId.make("draft") },
+      ownerKey: "draft", activeThread: undefined, threadRef: null,
+      serverProjection: null, activityRun: null, localPreparing: false,
+      sendQueuesBehindSetup: false, followUpSent: false,
+    });
+    return <span>{String(setup.blocksSend)}</span>;
+  }
+  await act(() => { container = document.createElement("div"); renderer = createRoot(container); renderer.render(<Probe />); });
+  expect(container.textContent).toBe("false");
+  expect(renders).toBeLessThan(5);
+});
diff --git a/apps/web/src/components/chat/useWorktreeSetup.ts b/apps/web/src/components/chat/useWorktreeSetup.ts
index d01cddf149..e875dc78d8 100644
