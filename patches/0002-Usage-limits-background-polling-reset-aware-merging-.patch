+  const metadata =
+    Date.parse(probed.checkedAt) >= Date.parse(normalizedPublished.checkedAt)
+      ? probed
+      : normalizedPublished;
+  const { unavailable: _unavailable, ...metadataWithoutFailure } = metadata;
+  const {
+    resetCredits: _resetCredits,
+    externalUsage: _externalUsage,
+    unavailable: _mergedUnavailable,
+    ...mergedWindows
+  } = merged;
+  return {
+    ...metadataWithoutFailure,
+    ...mergedWindows,
+    ...(probed.externalUsage ? { externalUsage: probed.externalUsage } : {}),
+  };
+}
+
+function makeUsageLimitsSnapshot(limits: ServerProviderUsageLimits): ServerProviderUsageLimits {
+  const nowMs = parseTimeMs(limits.checkedAt);
+  return {
+    ...limits,
+    windows: limits.windows.map((window) => {
+      const withCheckedAt = {
+        ...window,
+        checkedAt: window.checkedAt ?? limits.checkedAt,
+      };
+      return nowMs === undefined ? withCheckedAt : normalizeUsageWindow(withCheckedAt, nowMs);
+    }),
+  };
 }
