From: Tomer Vaknin <tomer@tec.org.il>
Date: Sat, 17 Oct 2026 20:22:19 +0300
Subject: [PATCH 7/9] fix(web): avoid render loops in incremental timeline
 projection

---
 ...ncrementalTimelineEntries.browser.test.tsx | 61 +++++++++++++++++++
 .../hooks/useIncrementalTimelineEntries.ts    | 32 ++++++----
 2 files changed, 80 insertions(+), 13 deletions(-)
 create mode 100644 apps/web/src/hooks/useIncrementalTimelineEntries.browser.test.tsx

diff --git a/apps/web/src/hooks/useIncrementalTimelineEntries.browser.test.tsx b/apps/web/src/hooks/useIncrementalTimelineEntries.browser.test.tsx
new file mode 100644
index 0000000000..78c4663c48
--- /dev/null
+++ b/apps/web/src/hooks/useIncrementalTimelineEntries.browser.test.tsx
@@ -0,0 +1,61 @@
+import { act, useState } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, expect, it, vi } from "vite-plus/test";
+import { useIncrementalTimelineEntries } from "./useIncrementalTimelineEntries";
+import { MessageId } from "@t3tools/contracts";
+import type { ChatMessage } from "../types";
+import type { TimelineEntry } from "../session-logic";
+
+let renderer: Root | null = null;
+let container: HTMLDivElement;
+beforeEach(() => vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true));
+afterEach(async () => {
+  await act(() => renderer?.unmount());
+  renderer = null;
+  vi.unstubAllGlobals();
+});
+
+it("settles when ChatView recreates timeline containers during a render retry", async () => {
+  let renders = 0;
+  function Probe() {
+    renders++;
+    const [ready, setReady] = useState(false);
+    if (!ready) setReady(true);
+    const entries = useIncrementalTimelineEntries(null, {
+      visibleTurnItems: [],
+      optimisticMessages: [],
+      anchoredMessages: [],
+      attachmentUrlById: new Map(),
+    });
+    return <span>{entries.length}</span>;
+  }
+  await act(() => { container = document.createElement("div"); renderer = createRoot(container); renderer.render(<Probe />); });
+  expect(container.textContent).toBe("0");
+  expect(renders).toBeLessThan(5);
+});
+
+it("reuses committed rows, applies message updates, and resets on a thread switch", async () => {
+  let entries: TimelineEntry[] = [];
+  const message: ChatMessage = {
+    id: MessageId.make("optimistic-1"), role: "user", text: "Hello",
+    runId: null, streaming: false,
+    createdAt: "2026-10-17T00:00:00.000Z", updatedAt: "2026-10-17T00:00:00.000Z",
+  };
+  function Probe({ threadKey, message }: { threadKey: string; message: ChatMessage }) {
+    entries = useIncrementalTimelineEntries(threadKey, {
+      visibleTurnItems: [], optimisticMessages: [message],
+      anchoredMessages: [], attachmentUrlById: new Map(),
+    });
+    return null;
+  }
+  await act(() => { container = document.createElement("div"); renderer = createRoot(container); renderer.render(<Probe threadKey="a" message={message} />); });
+  const first = entries;
+  await act(() => { renderer!.render(<Probe threadKey="a" message={message} />); });
+  expect(entries).toBe(first);
+  const updated = { ...message, text: "Updated" };
+  await act(() => { renderer!.render(<Probe threadKey="a" message={updated} />); });
+  expect(entries[0]).toMatchObject({ kind: "message", message: { text: "Updated" } });
+  const beforeSwitch = entries;
+  await act(() => { renderer!.render(<Probe threadKey="b" message={updated} />); });
+  expect(entries).not.toBe(beforeSwitch);
+});
diff --git a/apps/web/src/hooks/useIncrementalTimelineEntries.ts b/apps/web/src/hooks/useIncrementalTimelineEntries.ts
index d5910d2266..9e354bdc5d 100644
--- a/apps/web/src/hooks/useIncrementalTimelineEntries.ts
+++ b/apps/web/src/hooks/useIncrementalTimelineEntries.ts
@@ -1,4 +1,4 @@
-import { useState } from "react";
+import { useLayoutEffect, useRef } from "react";
 import {
   deriveTimelineEntriesFromVisibleTurnItemsWithState,
   type TimelineEntriesInput,
@@ -21,17 +21,23 @@ export function useIncrementalTimelineEntries(
   threadKey: string | null,
   input: TimelineEntriesInput,
 ): TimelineEntriesProjection["entries"] {
-  const [state, setState] = useState(() => ({
-    threadKey,
-    projection: deriveTimelineEntriesFromVisibleTurnItemsWithState(input),
-  }));
-  if (state.threadKey === threadKey && sameInput(state.projection.input, input)) {
-    return state.projection.entries;
-  }
-  const projection = deriveTimelineEntriesFromVisibleTurnItemsWithState(
-    input,
-    state.threadKey === threadKey ? state.projection : null,
-  );
-  setState({ threadKey, projection });
+  const committed = useRef<{
+    threadKey: string | null;
+    projection: TimelineEntriesProjection;
+  } | null>(null);
+  const previous = committed.current;
+  const projection =
+    previous?.threadKey === threadKey && sameInput(previous.projection.input, input)
+      ? previous.projection
+      : deriveTimelineEntriesFromVisibleTurnItemsWithState(
+          input,
+          previous?.threadKey === threadKey ? previous.projection : null,
+        );
+  // ChatView can recreate input containers on a render retry. Scheduling state
+  // here would retry forever. Cache only committed work, so abandoned concurrent
+  // renders cannot replace the projection used by the next update.
+  useLayoutEffect(() => {
+    committed.current = { threadKey, projection };
+  }, [threadKey, projection]);
   return projection.entries;
 }
