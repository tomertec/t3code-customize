+function providerAppearance(driver: string | undefined) {
+  switch (driver) {
+    case "codex":
+      return {
+        name: "Codex",
+        Icon: OpenAI,
+        theme: "[--stats-accent:#0f766e] dark:[--stats-accent:#5eead4]",
+      };
+    case "claudeAgent":
+      return {
+        name: "Claude",
+        Icon: ClaudeAI,
+        theme: "[--stats-accent:#a84e32] dark:[--stats-accent:#e7a38b]",
+      };
+    default:
+      return { name: null, Icon: null, theme: "[--stats-accent:var(--muted-foreground)]" };
+  }
+}
+
+function ProviderIdentity({ driver, name }: { driver: string | undefined; name?: string }) {
+  const provider = providerAppearance(driver);
+  const Icon = provider.Icon;
+  return (
+    <span className="inline-flex min-w-0 items-center gap-1.5 text-[var(--stats-accent)]">
+      {Icon && <Icon aria-hidden="true" className="size-3.5 shrink-0" />}
+      <span className="truncate font-medium">{name ?? provider.name ?? "Provider"}</span>
+    </span>
+  );
+}
